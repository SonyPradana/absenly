# Copy to .env, fill in, never commit .env.
#
# Every key is prefixed with ABSEN_ on purpose. Windows already sets USERNAME
# for the logged-in user, and dotenv does not override existing variables.

# --- ZK device (read-only) ---
# 192.0.2.10 is a documentation placeholder; replace it with your device IP/hostname.
ABSEN_ZK_HOST=192.0.2.10
ABSEN_ZK_PORT=4370
# Comm key 0 is the device default. Change only if the device has one.
ABSEN_ZK_COMM_KEY=0
ABSEN_ZK_TIMEOUT_MS=10000

# --- Work schedule ---
# Primary source: JSON calendar (base week + date-range overrides).
# Keep it next to the executable/.env. Schedule changes need an app restart.
ABSEN_SCHEDULE_FILE=schedule.json
# Emergency fallback only when the JSON file is missing: one flat shift for
# every day (including Sunday). Use schedule.json for days off/overrides.
ABSEN_SCHEDULE_IN=07:00
ABSEN_SCHEDULE_OUT=16:00

# --- Web admin ---
ABSEN_WEB_USER=admin
ABSEN_WEB_PASSWORD=
ABSEN_PORT=3000
# 0.0.0.0 = reachable from the LAN. Use 127.0.0.1 for local-only.
ABSEN_HOSTNAME=0.0.0.0

# --- Storage ---
# Production DB. Unit tests must use :memory:; staging must use a separate file.
# Never point tests or staging at the production absen.sqlite.
ABSEN_DB=absen.sqlite
# production | staging | test. staging/test refuse the default DB path above.
ABSEN_ENV=production

# --- Role: collector (default) or viewer ---
# Leave ABSEN_ROLE unset for a collector. A collector owns the DB and the device.
# A viewer (ABSEN_ROLE=viewer) has no DB and no device: it reads raw data from a
# collector over the relay below.
# ABSEN_ROLE=collector

# --- Relay collector (optional) ---
# Opt-in read-only listener on a specific address. Never bind 0.0.0.0/::.
# ABSEN_RELAY_ENABLED=false
# ABSEN_RELAY_HOST=192.0.2.20
# ABSEN_RELAY_PORT=3100
# Shared read-only token. Keep it out of version control.
# ABSEN_RELAY_TOKEN=<random token>

# --- Relay viewer (optional) ---
# Points at a collector's relay. No device config, no local DB, no sync.
# A viewer must NOT set ABSEN_ZK_HOST or ABSEN_RELAY_ENABLED=true.
# ABSEN_RELAY_URL=http://192.0.2.20:3100
# ABSEN_RELAY_TIMEOUT_MS=5000
